---
import Layout from "../layouts/Layout.astro";
import ImageLightbox from "../components/ImageLightbox.astro";
import LightboxImage from "../components/LightboxImage.astro";
import {
  hero,
  casesSection,
  mediaSection,
  reasons,
  organizationSection,
  statsSection,
  contactSection,
} from "../data/content";
import "../styles/landing.css";

const visibleCases = casesSection.items.slice(0, casesSection.visibleCount);
---

<Layout title="Kom Nu PostNord" lang="da">
  <div class="page">
    <header class="hero">
      <div class="hero-cyan">
        <svg
          class="hero-curve"
          viewBox="0 0 1440 200"
          xmlns="http://www.w3.org/2000/svg"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <ellipse cx="720" cy="300" rx="820" ry="200" fill="var(--brand-cyan)" />
        </svg>
        <div class="hero-body">
          <div class="hero-content">
            <h1 class="hero-title">{hero.title}</h1>
            <p class="hero-intro">{hero.body}</p>
          </div>
        </div>
      </div>
    </header>

    <section class="cases-section" aria-labelledby="cases-heading">
      <div class="cases-wrap">
        <h2 id="cases-heading" class="cases-heading">
          {casesSection.heading}
        </h2>
        <div class="cases-grid">
          {visibleCases.map((item) => (
            <article class="case-card">
              <LightboxImage
                src={item.src}
                alt={item.alt}
                imageClass="case-image"
              />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="media-section" aria-labelledby="media-heading">
      <div class="media-wrap">
        <h2 id="media-heading" class="media-heading">
          {mediaSection.heading}
        </h2>
        <div class="media-grid">
          {mediaSection.items.map((item) => (
            <article class="media-card">
              <LightboxImage
                src={item.src}
                alt={item.alt}
                imageClass="media-image"
              />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="reasons-section" aria-label="Tre årsager">
      <div class="reasons">
        {
          reasons.map((reason) => (
            <article
              class:list={[
                "reason",
                `reason--${reason.variant}`,
                `reason--anchor-${reason.anchor}`,
              ]}
            >
              <h2 class="reason-heading">{reason.heading}</h2>
              <p class="reason-body">{reason.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="org-section" aria-labelledby="org-heading">
      <div class="org-wrap">
        <h2 id="org-heading" class="org-heading">
          {organizationSection.heading}
        </h2>
        <p class="org-body">{organizationSection.body}</p>
        <div class="org-forms">
          {
            organizationSection.forms.map((form) => (
              <div class="org-form">
                <h3 class="org-form-label">{form.label}</h3>
                <iframe
                  data-tally-src={form.embedUrl}
                  loading="lazy"
                  width="100%"
                  height="420"
                  frameborder="0"
                  marginheight="0"
                  marginwidth="0"
                  title={form.label}
                />
              </div>
            ))
          }
        </div>
      </div>
    </section>
    <script is:inline async src="https://tally.so/widgets/embed.js"></script>

    {
      statsSection.enabled && (
        <section class="stats-section" aria-labelledby="stats-heading">
          <div class="stats-main">
            <h2 id="stats-heading" class="stats-heading">
              {statsSection.heading}
            </h2>
            <div class="stats-grid">
              {statsSection.items.map((item) => (
                <div class="stat-item">
                  <div class="stat-value">{item.value}</div>
                  <div class="stat-label">{item.label}</div>
                </div>
              ))}
            </div>
          </div>
          <div class="stats-media">
            <img
              src={statsSection.imageSrc}
              alt={statsSection.imageAlt}
              class="stats-img"
              loading="lazy"
            />
          </div>
        </section>
      )
    }

    <ImageLightbox />

    <section class="contact-section" aria-labelledby="contact-heading">
      <div class="contact-circle" aria-hidden="true"></div>
      <div class="contact-inner">
        <h2 id="contact-heading" class="contact-heading">
          {contactSection.heading}
        </h2>
        <div class="contact-details">
          <p class="contact-about-label">{contactSection.aboutLabel}</p>
          {
            contactSection.lines.map((line) => {
              const isWebsite = line === contactSection.website;
              const isEmail = line.includes("@");
              return (
                <p class="contact-line">
                  {isWebsite ? (
                    <a
                      href={`https://${line}`}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {line}
                    </a>
                  ) : isEmail ? (
                    <a href={`mailto:${line}`}>{line}</a>
                  ) : (
                    line
                  )}
                </p>
              );
            })
          }
        </div>
      </div>
    </section>
  </div>
</Layout>
