---
import Layout from "../layouts/Layout.astro";
import { hero, reasons, statsSection, contactSection } from "../data/content";
import "../styles/landing.css";
---

<Layout title="Kom Nu PostNord" lang="da">
  <div class="page">
    <header class="hero">
      <div class="hero-cyan">
        <svg
          class="hero-curve"
          viewBox="0 0 1440 200"
          xmlns="http://www.w3.org/2000/svg"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <ellipse cx="720" cy="300" rx="820" ry="200" fill="var(--brand-cyan)" />
        </svg>
        <div class="hero-body">
          <div class="hero-content">
            <h1 class="hero-title">{hero.title}</h1>
            <p class="hero-intro">{hero.body}</p>
          </div>
        </div>
      </div>
    </header>

    <section class="reasons-section" aria-label="Tre årsager">
      <div class="reasons">
        {
          reasons.map((reason) => (
            <article
              class:list={[
                "reason",
                `reason--${reason.variant}`,
                `reason--anchor-${reason.anchor}`,
              ]}
            >
              <h2 class="reason-heading">{reason.heading}</h2>
              <p class="reason-body">{reason.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="stats-section" aria-labelledby="stats-heading">
      <div class="stats-main">
        <h2 id="stats-heading" class="stats-heading">
          {statsSection.heading}
        </h2>
        <div class="stats-grid">
          {
            statsSection.items.map((item) => (
              <div class="stat-item">
                <div class="stat-value">{item.value}</div>
                <div class="stat-label">{item.label}</div>
              </div>
            ))
          }
        </div>
      </div>
      <div class="stats-media">
        <img src={statsSection.imageSrc} alt={statsSection.imageAlt} class="stats-img" loading="lazy" />
      </div>
    </section>

    <section class="contact-section" aria-labelledby="contact-heading">
      <div class="contact-circle" aria-hidden="true"></div>
      <div class="contact-inner">
        <h2 id="contact-heading" class="contact-heading">
          {contactSection.heading}
        </h2>
        <div class="contact-details">
          <p class="contact-about-label">{contactSection.aboutLabel}</p>
          {
            contactSection.lines.map((line) => {
              const isWebsite = line === contactSection.website;
              const isEmail = line.includes("@");
              return (
                <p class="contact-line">
                  {isWebsite ? (
                    <a
                      href={`https://${line}`}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {line}
                    </a>
                  ) : isEmail ? (
                    <a href={`mailto:${line}`}>{line}</a>
                  ) : (
                    line
                  )}
                </p>
              );
            })
          }
        </div>
      </div>
    </section>
  </div>
</Layout>
