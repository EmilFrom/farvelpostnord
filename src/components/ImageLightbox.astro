---
---

<dialog class="lightbox" id="image-lightbox" aria-label="Billede i fuld størrelse">
  <button type="button" class="lightbox-close" aria-label="Luk">×</button>
  <img class="lightbox-image" src="" alt="" />
</dialog>

<script>
  const dialog = document.getElementById("image-lightbox");
  const image = dialog?.querySelector(".lightbox-image");
  const closeButton = dialog?.querySelector(".lightbox-close");

  if (dialog instanceof HTMLDialogElement && image instanceof HTMLImageElement) {
    document.addEventListener("click", (event) => {
      const trigger = (event.target as Element).closest(".lightbox-trigger");
      if (!(trigger instanceof HTMLElement)) return;

      const src = trigger.dataset.lightboxSrc;
      if (!src) return;

      image.src = src;
      image.alt = trigger.dataset.lightboxAlt ?? "";
      dialog.showModal();
    });

    closeButton?.addEventListener("click", () => dialog.close());

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .lightbox {
    width: min(96vw, 72rem);
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgba(10, 31, 68, 0.92);
  }

  .lightbox-image {
    display: block;
    width: 100%;
    max-height: 90vh;
    height: auto;
    object-fit: contain;
    border-radius: 0.5rem;
    background: #0a1f44;
  }

  .lightbox-close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 1;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.95);
    color: #0a1f44;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox-close:hover {
    background: #ffffff;
  }

  .lightbox-close:focus-visible {
    outline: 2px solid #009fda;
    outline-offset: 2px;
  }
</style>
